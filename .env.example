# --- IA ---
# OJO: este fichero SÍ se sube al repositorio. Aquí van los nombres de las
# variables, nunca sus valores. Las claves de verdad, solo en .env.local.
# Claude: lee los flyers subidos y redacta el prompt de marca.
ANTHROPIC_API_KEY=
# OpenAI (gpt-image-1): genera la imagen del flyer. Se paga por imagen.
OPENAI_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=TardeosClub <hola@tudominio.com>

# --- Notificaciones push ---
# Par VAPID. Generar con: npx web-push generate-vapid-keys
# La pública viaja al navegador; la privada firma los envíos y NO sale del servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@tudominio.com

# --- Recordatorios automáticos ---
# Secreto que protege /api/recordatorios. Generar con: openssl rand -hex 32
CRON_SECRET=
