# Copia este archivo a .env.local y rellena los valores.
# .env.local NO se sube a git.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Salta RLS: no la expongas nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA ---
# Claude: lee los flyers subidos y redacta el prompt de marca.
ANTHROPIC_API_KEY=
# OpenAI (gpt-image-1): genera la imagen del flyer. Se paga por imagen.
OPENAI_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=TardeosClub <hola@tudominio.com>

# --- Recordatorios automáticos ---
# Secreto que protege /api/recordatorios. Generar con: openssl rand -hex 32
CRON_SECRET=
# URL publica del sitio, usada en los enlaces de los emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
